{
  "tabWidth": 2,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "es5",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react(?:-dom)?(?:/.*)?$",
    "",
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "",
    "^(?!.*\\.(?:css|scss|sass|less)$)(?:\\.{1,2}/)+(?:components/|(?:Board|Settings|ui)/|[A-Z][^/]*$|app$)",
    "",
    "^(?:\\.{1,2}/)+(?:hooks/|use[^/]*$|reduxHooks$)",
    "",
    "^(?!.*\\.(?:css|scss|sass|less)$)[./]",
    "",
    "\\.(?:css|scss|sass|less)$"
  ],
  "importOrderCaseSensitive": true,
  "importOrderTypeScriptVersion": "5.1.6",
  "importOrderSafeSideEffects": ["\\.(?:css|scss|sass|less)$"]
}
